{
  "name": "cognitive-alarm-platform",
  "version": "1.0.0",
  "description": "Cognitive Alarm Platform - Fullstack Microservices Orchestrator",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run backend\" \"npm run frontend\"",
    "backend": "python -m uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir backend --reload",
    "frontend": "npm --prefix frontend run dev",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "legacy": "node legacy/server.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
